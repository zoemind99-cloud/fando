<section class="section section--muted" aria-labelledby="problem-title">
  <div class="container">
    <div class="section__header">
      <h2 id="problem-title" class="section__title">{{ block.title | safe }}</h2>
    </div>
    <div class="problem-grid">
      {% for card in block.cards %}
      <article class="problem-card">
        <h3 class="problem-card__q">{{ card.question }}</h3>
        <p class="problem-card__a">{{ card.answer | safe }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
